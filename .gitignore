# Machine-specific config (written by scripts/setup.ps1)
local.config.json

# Pipeline output, wherever it lands
/renders/
/posters/
workspace-template/renders/*
!workspace-template/renders/.gitkeep
workspace-template/posters/*
!workspace-template/posters/.gitkeep
workspace-template/input/*
!workspace-template/input/.gitkeep
workspace-template/fit/*
!workspace-template/fit/.gitkeep

# Generated reference meshes (rebuilt from reference.json by fit_check.py)
references/*/proxy.stl

# Blender backups
*.blend1
*.blend2

__pycache__/
*.pyc
.mcpb-cache/
